score=1
while score <= 200:
    score+=1
    print(score)
while score <= 100000:
    score+=score/100
    print(score)
while score <= 100000000:
    score=score*2
    print(score)
while score <= 100000000000:
    score=score*3
    print(score)
while score <= 10**14:
    score=score*4
    print(score)
while score <= 10**17:
    score=score*5
    print(score)
while score <= 10**20:
    score=score*6
    print(score)

while score <= 10**23:
    score=score*7
    print(score)

while score <= 10**26:
    score=score*8
    print(score)

while score <= 10**29:
    score=score*9
    print(score)

while score <= 10**32:
    score=score**2
    print(score)

while score <= 10**35:
    score=score**3
    print(score)

while score <= 10**38:
    score=score**4
    print(score)

while score <= 10**41:
    score=score**5
    print(score)
